{
  "name": "zuri-desktop",
  "productName": "Zuri",
  "version": "0.2.9",
  "private": true,
  "description": "Zuri Desktop - a local AI command centre for Windows",
  "author": "Zuri",
  "type": "module",
  "main": "src/main/bootstrap.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron scripts/smoke.js",
    "selftest": "node scripts/selftest.js",
    "office:render": "node scripts/render-office.mjs",
    "firstrun": "electron scripts/firstrun.js",
    "demo:act": "node scripts/demo-act.js",
    "demo:autopilot": "node scripts/demo-autopilot.js",
    "react:dev": "vite",
    "react:build": "vite build",
    "web:build": "vite build --config vite.web.config.mjs",
    "android:build": "node scripts/build-android.mjs",
    "server:test": "npm --prefix server test",
    "cloud:deploy": "node scripts/deploy-cloud.mjs",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "test": "npm run react:build && npm run server:test && npm run smoke && npm run selftest && npm run firstrun && npm run demo:act && npm run demo:autopilot && npm run sync:check",
    "release:publish": "node scripts/publish-release.mjs",
    "sync:check": "electron scripts/check-chat-sync.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^41.7.1",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.5"
  },
  "build": {
    "appId": "com.zuri.desktop",
    "productName": "Zuri",
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "src/main/**/*",
      "src/addin/**/*",
      "src/shared/**/*",
      "dist-react/**/*",
      "!node_modules/@capacitor/android/capacitor/build/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/es-abstract-get",
        "to": "node_modules/es-abstract-get"
      },
      {
        "from": "node_modules/es-errors",
        "to": "node_modules/es-errors"
      },
      {
        "from": "node_modules/es-object-atoms",
        "to": "node_modules/es-object-atoms"
      },
      {
        "from": "node_modules/is-callable",
        "to": "node_modules/is-callable"
      },
      {
        "from": "node_modules/object-inspect",
        "to": "node_modules/object-inspect"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/main/assets/zuri-icon.ico",
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "src/main/assets/zuri-icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "nsis": {
      "include": "scripts/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "src/main/assets/zuri-icon.ico",
      "uninstallerIcon": "src/main/assets/zuri-icon.ico",
      "installerHeaderIcon": "src/main/assets/zuri-icon.ico",
      "shortcutName": "Zuri",
      "uninstallDisplayName": "Zuri ${version}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "call-bind-apply-helpers": "^1.0.2",
    "docx": "^9.14.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^14.6.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "officeparser": "^7.8.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
