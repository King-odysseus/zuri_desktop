# Dependencies and build output
node_modules/
dist/
release/

# Provider API keys never belong in the repository. The app writes this file into
# userData/zuri, outside the checkout, and this pattern also covers a stray copy
# inside the tree (for example one left by a manual test).
secrets.json
.env
.env.*

# Run output, not source. A redirected check (for example `npm run smoke >
# .smoke-out.log`) used to land here and be committed by mistake, which leaves the
# checkout changing under a passing check. Redirect into the temp folder instead.
*.log

# React/HeroUI migration build output
dist-react/
dist-android/

# Desktop installers served by the cloud site. The Windows build is 140 MB,
# past GitHub's 100 MB per-file limit, so git cannot carry it: `npm run
# cloud:deploy` uploads the folder with the server instead.
server/downloads/
